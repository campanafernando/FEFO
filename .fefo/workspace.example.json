{
  "fefo": 1,
  "name": "Example Workspace",
  "provider": {
    "model": null
  },
  "harnesses": ["opencode", "claude", "cursor", "copilot"],
  "browse": true,
  "repos": [
    {
      "name": "api",
      "path": "../api",
      "role": "api",
      "stack": "django",
      "mcp": "codegraph-api",
      "codegraph": true,
      "commands": {
        "test": "python manage.py test",
        "lint": "ruff check .",
        "build": "python manage.py check"
      }
    },
    {
      "name": "web",
      "path": "../web",
      "role": "web",
      "stack": "next",
      "mcp": "codegraph-web",
      "codegraph": true,
      "commands": {
        "test": "npm run test",
        "lint": "npm run lint",
        "build": "npm run build"
      }
    }
  ],
  "plugins": [],
  "opencode": {},
  "claude_settings": {},
  "mcp_servers": {}
}
