#!/usr/bin/env zsh
# tests/vault.zsh — generated code vaults (lib/vault.zsh), plain zsh, temp dirs, shim-free
emulate -L zsh
setopt local_options extended_glob no_unset pipe_fail

FEFO_ROOT=${0:A:h:h}
export FEFO_HOME=$FEFO_ROOT
FEFO=$FEFO_ROOT/bin/fefo
PASS=0
FAIL=0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

HOME=$tmp/home; mkdir -p "$HOME/.config" "$HOME/.cache"
export HOME
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export FEFO_YES=1
export FEFO_SKIP_UPDATE_CHECK=1
export PATH=$FEFO_ROOT/bin:$PATH

t() {  # t NAME CONDITION...
  local name=$1; shift
  if eval "$*"; then ((PASS++)); print "PASS $name"
  else ((FAIL++)); print "FAIL $name" >&2
  fi
}

# ---------- fake django repo: 2 apps ----------
REPO=$tmp/ws/myapp
mkdir -p "$REPO/app1" "$REPO/app2"
git -C "$REPO" init -q
git -C "$REPO" config user.email t@t
git -C "$REPO" config user.name t

print -r -- '#!/usr/bin/env python' > "$REPO/manage.py"

# app1
cat > "$REPO/app1/apps.py" <<'EOF'
from django.apps import AppConfig


class App1Config(AppConfig):
    name = 'app1'
    verbose_name = "First App"
EOF
: > "$REPO/app1/__init__.py"
cat > "$REPO/app1/models.py" <<'EOF'
from django.db import models


class Author(models.Model):
    name = models.CharField(max_length=100)
EOF
cat > "$REPO/app1/views.py" <<'EOF'
from django.http import JsonResponse
from .models import Author


def author_list(request):
    return JsonResponse({'n': Author.objects.count()})
EOF
cat > "$REPO/app1/urls.py" <<'EOF'
from django.urls import path
from . import views

urlpatterns = [
    path('authors/', views.author_list, name='author-list'),
]
EOF
# app1 service importing other app's model
cat > "$REPO/app1/services.py" <<'EOF'
from app2.models import Item


def sync_item():
    return Item.objects.count()
EOF

# app2
cat > "$REPO/app2/apps.py" <<'EOF'
from django.apps import AppConfig


class App2Config(AppConfig):
    name = 'app2'
    verbose_name = 'Second App'
EOF
: > "$REPO/app2/__init__.py"
cat > "$REPO/app2/models.py" <<'EOF'
from django.db import models


class Item(models.Model):
    name = models.CharField(max_length=100)
EOF

# skipped: tests + migrations
print -r -- 'def test_x():\n    pass' > "$REPO/app1/tests.py"
mkdir -p "$REPO/app1/migrations"
print -r -- 'x = 1' > "$REPO/app1/migrations/0001_initial.py"

git -C "$REPO" add -A
git -C "$REPO" commit -qm init

# ---------- fefo init ----------
WS=$tmp/ws
cd "$WS"
"$FEFO" init --cheap --yes >/dev/null 2>&1 || { print FAIL init >&2; exit 1 }

OUT=$WS/docs/vault/myapp-vault

# ---------- fefo vault ----------
vout=$("$FEFO" vault 2>&1)

t 'vault prints modules+seconds' '[[ $vout == *"fefo: vault myapp ("*"modules, "*"s)"* ]]'
t '00-INDEX exists' '[[ -f $OUT/00-INDEX.md ]]'
t 'modules/app1 note' '[[ -f $OUT/modules/app1.md ]]'
t 'modules/app2 note' '[[ -f $OUT/modules/app2.md ]]'
t 'recent.md' '[[ -f $OUT/recent.md ]]'

IDX=$OUT/00-INDEX.md
t 'index header' '[[ $(head -1 "$IDX") == "# myapp — code vault" ]]'
t 'index repo line' 'grep -q "^repo .* · stack .* · HEAD .* · generated by fefo vault$" "$IDX"'
t 'index 2 module rows' '[[ $(grep -c "^| app" "$IDX") == 2 ]]'
t 'role app1 verbose_name' 'grep -q "^| app1 | First App |" "$IDX"'
t 'role app2 verbose_name' 'grep -q "^| app2 | Second App |" "$IDX"'
t 'index note link app1' 'grep -q "^| app1 .* \[\[modules/app1\]\] |$" "$IDX"'
t 'index note link app2' 'grep -q "^| app2 .* \[\[modules/app2\]\] |$" "$IDX"'
t 'entry point manage.py' 'grep -q "^- manage.py$" "$IDX"'
t 'entry point app urls' 'grep -q "^- app1/urls.py$" "$IDX"'
t 'how to use 3 lines' '[[ $(awk "/## How to use/{f=1;next} f&&NF{n++} END{print n}" "$IDX") == 3 ]]'
t 'usages git -C grep' 'grep -q "git -C .* grep -n" "$IDX"'

A1=$OUT/modules/app1.md
A2=$OUT/modules/app2.md
t 'app1 title' '[[ $(head -1 "$A1") == "# app1" ]]'
t 'app1 role' 'grep -q "^Role: First App$" "$A1"'
t 'app2 role' 'grep -q "^Role: Second App$" "$A2"'
t 'app1 files' 'grep -q "^app1/models.py$" "$A1"'
t 'app1 defs path:line model' 'grep -q "^app1/models.py — Author:4" "$A1"'
t 'app1 defs path:line view' 'grep -q "^app1/views.py — author_list:5" "$A1"'
t 'app1 defs path:line service' 'grep -q "^app1/services.py — sync_item:4" "$A1"'
t 'app1 route' 'grep -q "^- authors/ → views.author_list$" "$A1"'
t 'app1 model' 'grep -q "^- Author (app1/models.py:4)$" "$A1"'
t 'app2 model' 'grep -q "^- Item (app2/models.py:4)$" "$A2"'
t 'app1 imports from app2' 'grep -A2 "## Imports from" "$A1" | grep -q "\[\[modules/app2\]\]"'
t 'app2 imported by app1' 'grep -A2 "## Imported by" "$A2" | grep -q "\[\[modules/app1\]\]"'
t 'app2 used by Item' 'grep -A3 "## Used by" "$A2" | grep -q "Item → app1/services.py"'
t 'app1 used by Author' 'grep -A3 "## Used by" "$A1" | grep -q "Author → app1/views.py"'

# tests + migrations absent
t 'tests.py absent' '! grep -q "tests.py" "$OUT"/modules/*.md'
t 'migrations absent' '! grep -q "migrations" "$OUT"/modules/*.md'
t 'no test symbol' '! grep -q "test_x" "$OUT"/modules/*.md'

# recent.md counts
REC=$OUT/recent.md
t 'recent commit line' 'grep -qE "^- [0-9a-f]+ [0-9-]+ init — app1\([0-9]+\), app2\([0-9]+\)$" "$REC"'

# gitignore
t '.gitignore has vault ignore' 'grep -Fxq "/docs/vault/*-vault/" "$WS/.gitignore"'

# ---------- --changed ----------
cout=$("$FEFO" vault --changed 2>&1)
t '--changed unchanged' '[[ $cout == *"fefo: vault myapp unchanged"* ]]'

# ---------- new commit → regenerated ----------
printf 'from django.db import models\n\n\nclass Extra(models.Model):\n    pass\n' >> "$REPO/app2/models.py"
git -C "$REPO" add -A
git -C "$REPO" commit -qm 'add Extra'
nout=$("$FEFO" vault --changed 2>&1)
t '--changed regenerates after commit' '[[ $nout == *"fefo: vault myapp ("*"modules, "*"s)"* ]]'
t 'not unchanged after commit' '[[ $nout != *unchanged* ]]'
t 'new model present' 'grep -q "^- Extra (app2/models.py:" "$A2"'
t 'new def present' 'grep -q "^app2/models.py — Item:4, Extra:" "$A2"'

# ---------- write-if-changed ----------
f1=$(stat -c %Y "$A1" 2>/dev/null || stat -f %m "$A1")
sleep 1
"$FEFO" vault >/dev/null 2>&1
f2=$(stat -c %Y "$A1" 2>/dev/null || stat -f %m "$A1")
t 'unchanged file not rewritten' '[[ $f1 == $f2 ]]'

# ---------- per-repo vault=off ----------
cp "$WS/.fefo/workspace.zsh" "$tmp/ws.bak"
sed -i 's/vault=on/vault=off/' "$WS/.fefo/workspace.zsh"
poff=$("$FEFO" vault --force 2>&1)
t 'per-repo vault=off skips' '[[ -z $poff ]]'
cp "$tmp/ws.bak" "$WS/.fefo/workspace.zsh"

print -r -- "== RESULT: PASS=$PASS FAIL=$FAIL"
(( FAIL == 0 )) || exit 1
exit 0
